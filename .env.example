# AgentShield environment. Copy to `.env` and adjust; only this example file is
# meant to be committed. Every value below also has a default in
# docker-compose.yml, so the stack runs without a .env for local demos.
# These are LOCAL DEMO credentials - change them for anything shared.

COMPOSE_PROJECT_NAME=agentshield
# Published ports listen on this address only. The demo API has no authentication: keep 127.0.0.1
# unless you deliberately expose the stack on a trusted network.
BIND_ADDRESS=127.0.0.1

# PostgreSQL (operational DB + Iceberg JDBC catalog + Airflow metadata)
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield
POSTGRES_DB=agentshield
ICEBERG_CATALOG_DB=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
POSTGRES_HOST_PORT=5433        # host port for the Docker Postgres (5432 is often taken by a local install)

# MinIO (S3-compatible object storage for Iceberg data/metadata files)
MINIO_ROOT_USER=agentshield
MINIO_ROOT_PASSWORD=agentshield-minio-secret

# Spark Structured Streaming
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=1536m
SPARK_TRIGGER_SECONDS=10
SPARK_MAX_OFFSETS_PER_TRIGGER=300000
SPARK_WATERMARK_DELAY=30 minutes

# Platform behaviour
CAPTURE_CONTENT=false          # never store prompt/answer previews unless true (redacted when stored)
TRINO_QUERY_TIMEOUT_S=60

# Optional LLM provider for the investigation assistant / LLM judge.
# The platform is fully functional with LLM_PROVIDER=none (deterministic fallback).
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
